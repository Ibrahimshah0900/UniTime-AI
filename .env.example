# UniTime-AI environment configuration
#
# Copy this file to .env only for local/manual configuration.
# Never commit real passwords, database credentials, tokens,
# or production secrets.

# Application environment:
# development | production
APP_ENV=development

# Database connection.
# Local development example:
DATABASE_URL=sqlite:///D:/UniTime-AI/data/unitime_ai.db

# Production example will later use hosted PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Comma-separated frontend origins allowed to call the API.
# Local frontend examples:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Production example:
# CORS_ORIGINS=https://your-frontend-domain.com

# Application logging level:
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Hosts allowed to reach the FastAPI application.
# Local development:
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Production example:
# ALLOWED_HOSTS=api.your-university-domain.com


# In production use real deployed domains:
#
# APP_ENV=production
# CORS_ORIGINS=https://app.your-university-domain.com
# ALLOWED_HOSTS=api.your-university-domain.com
#
# Swagger, ReDoc, and OpenAPI endpoints are automatically
# disabled when APP_ENV=production.

# Maximum timetable CSV/XLSX upload size in megabytes.
MAX_TIMETABLE_UPLOAD_MB=10

# Authentication
# Generate a strong unique secret for deployed environments.
# Production rejects an empty/default secret and secrets shorter than 32 chars.
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_MINUTES=60

# IANA timezone used for timetable reminders and daily summaries.
APP_TIMEZONE=Asia/Karachi
