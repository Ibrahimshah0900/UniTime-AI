# UniTime-AI environment configuration
#
# Copy this file to .env only for local/manual configuration.
# Never commit real passwords, database credentials, tokens,
# or production secrets.

APP_ENV=development

# Portable local database path, relative to the repository root.
DATABASE_URL=sqlite:///./data/unitime_ai.db

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# Vite web origins plus Capacitor local origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

LOG_LEVEL=INFO

# Add the laptop LAN IPv4 address here when testing from a physical phone.
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,testserver

MAX_TIMETABLE_UPLOAD_MB=10

AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_MINUTES=60

ALLOW_PUBLIC_STUDENT_REGISTRATION=true
APP_TIMEZONE=Asia/Karachi

# Hard safety remains deterministic in every ranking mode.
CANDIDATE_RANKER_MODE=experimental_catboost